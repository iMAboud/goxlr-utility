+  window.goxlrFavItems = JSON.parse(localStorage.getItem("goxlr_fav_items") || "[]");
+} catch(e) { window.goxlrFavItems = []; }
+
+window.applyUiCustomizations = function() {
+  const isEdit = !!window.goxlrEditMode;
+  const hidden = new Set(window.goxlrHiddenElements || []);
+  const favs = new Set((window.goxlrFavItems || []).map(i => i.id));
+
+  const selectors = [
+    ".group-container", ".content-container", ".section",
+    ".microphone-profiles", ".microphone-setup", ".gate-container", ".equaliser-container", ".compressor-container",
+    ".mixer-channel", ".submix-container", ".faders-container", ".cough-container",
+    ".effects-preset", ".reverb-container", ".echo-container", ".pitch-container", ".gender-container", ".megaphone-container", ".robot-container", ".hardtune-container",
+    ".sampler-bank", ".lighting-area", ".routing-table", ".utility-settings", ".system-info"
+  ];
+
+  const elements = document.querySelectorAll(selectors.join(", "));
+  elements.forEach((el, index) => {
+    if (el.closest(".goxlr-home-container")) return;
+
+    let id = el.getAttribute("data-custom-id") || el.id;
+    if (!id) {
+      const titleEl = el.querySelector(".title, h1, h2, h3, .header");
+      const titleText = titleEl ? titleEl.textContent.trim().replace(/\s+/g, "_") : "";
+      id = "goxlr_block_" + (titleText || index);
+      el.setAttribute("data-custom-id", id);
+    }
+
+    if (hidden.has(id)) {
+      if (isEdit) {
+        el.classList.add("goxlr-ui-hidden-edit");
+        el.classList.remove("goxlr-ui-hidden-normal");
+      } else {
+        el.classList.add("goxlr-ui-hidden-normal");
+        el.classList.remove("goxlr-ui-hidden-edit");
+      }
+    } else {
+      el.classList.remove("goxlr-ui-hidden-normal", "goxlr-ui-hidden-edit");
+    }
+
+    let actions = el.querySelector(":scope > .goxlr-card-actions");
+    if (isEdit) {
+      if (!actions) {
+        actions = document.createElement("div");
+        actions.className = "goxlr-card-actions";
+        if (getComputedStyle(el).position === "static") {
+          el.style.position = "relative";
+        }
+        el.insertBefore(actions, el.firstChild);
+      }
+
+      const isFav = favs.has(id);
+      const isHid = hidden.has(id);
+      const titleEl = el.querySelector(".title, h1, h2, h3, .header");
+      const title = titleEl ? titleEl.textContent.trim() : ("Block " + id);
+
+      actions.innerHTML = `
+        <button class="goxlr-card-action-btn ${isFav ? "fav-active" : ""}" title="${isFav ? "Remove from Home" : "Add to Home"}">
+          ${isFav ? "Γÿà" : "Γÿå"}
+        </button>
+        <button class="goxlr-card-action-btn" title="${isHid ? "Unhide Element" : "Hide Element"}">
+          ${isHid ? "≡ƒæü" : "≡ƒÜ½"}
+        </button>
+      `;
+
+      const favBtn = actions.children[0];
+      const hideBtn = actions.children[1];
+
+      favBtn.onclick = (e) => {
+        e.stopPropagation();
+        e.preventDefault();
+        let currentFavs = window.goxlrFavItems || [];
+        if (currentFavs.some(i => i.id === id)) {
+          window.goxlrFavItems = currentFavs.filter(i => i.id !== id);
+        } else {
+          const clone = el.cloneNode(true);
+          const act = clone.querySelector(".goxlr-card-actions");
+          if (act) act.remove();
+          window.goxlrFavItems.push({
+            id: id,
+            title: title,
+            html: clone.innerHTML,
+            width: "50%",
+            height: "auto",
+            order: currentFavs.length
+          });
+        }
+        localStorage.setItem("goxlr_fav_items", JSON.stringify(window.goxlrFavItems));
+        window.dispatchEvent(new CustomEvent("goxlr-favs-updated"));
+        window.applyUiCustomizations();
+      };
+
+      hideBtn.onclick = (e) => {
+        e.stopPropagation();
+        e.preventDefault();
+        let currentHidden = window.goxlrHiddenElements || [];
+        if (currentHidden.includes(id)) {
+          window.goxlrHiddenElements = currentHidden.filter(x => x !== id);
+        } else {
+          window.goxlrHiddenElements.push(id);
+        }
+        localStorage.setItem("goxlr_hidden_elements", JSON.stringify(window.goxlrHiddenElements));
+        window.dispatchEvent(new CustomEvent("goxlr-hidden-updated"));
+        window.applyUiCustomizations();
+      };
+    } else {
+      if (actions) actions.remove();
+    }
+  });
+};
