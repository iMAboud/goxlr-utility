+        k("p", { style: { "font-weight": "600", "font-size": "16px", "margin-bottom": "8px" } }, "Home Tab"),
+        k("p", null, 'No favorited settings yet. Click "Customize UI" in the header to favorite settings or blocks from any tab to display them here.')
+      ]);
+    }
+
+    const itemNodes = this.items.map((item, idx) => {
+      const controls = isEdit ? k("div", { class: "goxlr-home-controls" }, [
+        k("span", { style: { "font-weight": "600", "color": "#fff" } }, item.title || ("Item " + (idx + 1))),
+        k("button", {
+          class: "goxlr-card-action-btn",
+          disabled: idx === 0,
+          onClick: () => this.moveFav(idx, -1)
+        }, "Γùä"),
+        k("button", {
+          class: "goxlr-card-action-btn",
+          disabled: idx === this.items.length - 1,
+          onClick: () => this.moveFav(idx, 1)
+        }, "Γû║"),
+        k("label", { style: { "margin-left": "8px" } }, "Width:"),
+        k("select", {
+          value: item.width || "50%",
+          onChange: (e) => this.updateWidth(item, e.target.value)
+        }, [
+          k("option", { value: "25%" }, "25%"),
+          k("option", { value: "33%" }, "33%"),
+          k("option", { value: "50%" }, "50%"),
+          k("option", { value: "75%" }, "75%"),
+          k("option", { value: "100%" }, "100%")
+        ]),
+        k("label", { style: { "margin-left": "8px" } }, "Height:"),
+        k("select", {
+          value: item.height || "auto",
+          onChange: (e) => this.updateHeight(item, e.target.value)
+        }, [
+          k("option", { value: "auto" }, "Auto"),
+          k("option", { value: "200px" }, "200px"),
+          k("option", { value: "300px" }, "300px"),
+          k("option", { value: "400px" }, "400px"),
+          k("option", { value: "500px" }, "500px")
+        ]),
+        k("button", {
+          class: "goxlr-card-action-btn",
+          style: { "margin-left": "auto", "color": "#ff5555" },
+          onClick: () => this.removeFav(item.id)
+        }, "Γ£û Remove")
+      ]) : null;
+
+      const content = k("div", {
+        class: "goxlr-home-item-content",
+        innerHTML: item.html || ""
+      });
+
+      return k("div", {
+        key: item.id || idx,
+        class: "goxlr-home-item",
+        style: {
+          width: "calc(" + (item.width || "50%") + " - 12px)",
+          height: item.height || "auto",
+          "min-width": "280px"
+        }
+      }, [controls, content]);
+    });
+
+    return k("div", { class: "goxlr-home-container" }, itemNodes);
+  }
+};
